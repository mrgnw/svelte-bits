{
	"name": "svelte-bits",
	"version": "0.0.1",
	"license": "MIT",
	"description": "Reusable Svelte 5 components: TierBar, a width-tiered collapsing bar, and SectionNav, a scroll-tracking sections sidebar.",
	"author": "Morgan Williams",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mrgnw/svelte-bits.git"
	},
	"homepage": "https://github.com/mrgnw/svelte-bits#readme",
	"bugs": {
		"url": "https://github.com/mrgnw/svelte-bits/issues"
	},
	"keywords": [
		"svelte",
		"svelte5",
		"components",
		"navigation",
		"tabs",
		"sidebar",
		"container-queries"
	],
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"types": "./dist/index.d.ts",
	"svelte": "./dist/index.js",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./section-nav": {
			"types": "./dist/section-nav/index.d.ts",
			"svelte": "./dist/section-nav/index.js"
		}
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && pnpm run prepack",
		"build:ce": "vite build --config vite.ce.config.ts",
		"preview": "vite preview",
		"site:preview": "pnpm build && wrangler dev --port 5263",
		"ship": "pnpm build && wrangler deploy",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@twinkleplop/core": "0.3.1",
		"@twinkleplop/svelte": "^0.1.7",
		"@twinkleplop/theme-github": "^0.2.4",
		"@types/node": "^26.6.6",
		"@vitest/browser-playwright": "^4.1.8",
		"playwright": "^1.60.0",
		"publint": "^0.3.21",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1",
		"wrangler": "^4.158.0"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"browserslist": [
		"baseline widely available"
	]
}
